{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)c1e4d200-bc2a-4301-a4a6-c69dfa5ef66c","ParentGuid":"(Guid)542b4cb4-81da-47f9-8583-4e43e03c2aca","Name":"(string)Subscriber","Properties":{"@Type":"2c41fa04:IDictionary","@Value":{}},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)CASE State OF\n\n    0: // WAIT FOR MQTT CONNECTION\n\n        IF Global_DB.MQTT_IN_OUT.BROKER_CONNECTED THEN\n            State := 1;\n        END_IF;\n\n\n    1: // INITIALIZE SUBSCRIPTION\n\n        SUB1.SetMqttInOut(\n            MQTT_IN_OUT := Global_DB.MQTT_IN_OUT\n        );\n\n        collector.put(\n            instance := receiver\n        );\n\n        receiver.initAsFindTopic(\n            compString := ADR('PLC/command'),\n            returnHit := TRUE\n        );\n\n        State := 2;\n\n\n    2: // SUBSCRIBE\n\n        SUB1(\n            Subscribe := TRUE,\n            Topic := ADR('PLC/command'),\n            QoSSubscribe := MQTT.QoS.ExactlyOnce,\n            ExpectingString := FALSE,\n            Callback := collector\n        );\n\n       State := 3;\n\n\n    3: // WAIT / RECEIVE\n\n        command := receiver.MQTTReceived;\n    IF command <> lastCommand THEN\n        IF command = 'START' THEN\n            Start := TRUE;\n\t\t\tStop := FALSE;\n        END_IF;\n\n        IF command = 'STOP' THEN\n            Stop := TRUE;\n\t\t\tStart := FALSE;\n        END_IF;\n\t\tlastCommand := command;\n     END_IF;\n\t \n\t \tIF NOT NotAus OR NOT L_Stop OR L_Start THEN\n\t\t\tStop := FALSE;\n\t\t\tStart := FALSE;\n\t\tEND_IF\n\nEND_CASE;","LineInfoPersistence":"(string)c1e4d200-bc2a-4301-a4a6-c69dfa5ef66c_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)FUNCTION_BLOCK Subscriber\n\nVAR_INPUT\n\tNotAus: BOOL;\n\tL_Start: BOOL;\n\tL_Stop: BOOL;\nEND_VAR\n\nVAR_OUTPUT\n    Start : BOOL;\n    Stop : BOOL;\nEND_VAR\n\nVAR\n    collector : MQTT.CallbackCollector;\n    SUB1 : MQTT.MQTTSubscribe;\n    receiver : MQTT.ReceiveString;\n\n    init : BOOL;\n    command : STRING;\n\tlastCommand : STRING;\n\tstate: INT;\nEND_VAR\n","LineInfoPersistence":"(string)c1e4d200-bc2a-4301-a4a6-c69dfa5ef66c_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)322","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}