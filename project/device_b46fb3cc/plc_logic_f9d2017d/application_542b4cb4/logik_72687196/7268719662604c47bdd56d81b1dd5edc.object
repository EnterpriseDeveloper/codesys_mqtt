{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)72687196-6260-4c47-bdd5-6d81b1dd5edc","ParentGuid":"(Guid)542b4cb4-81da-47f9-8583-4e43e03c2aca","Name":"(string)Logik","Properties":{"@Type":"2c41fa04:IDictionary","@Value":{}},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string){region 'STEP_0'}\n    IF (Steps = 0 OR Steps = 1) THEN\n        Emitter := FALSE;\n        Band_Einlauf := FALSE;\n        Sortierband_Vor := FALSE;\n        Band_Links := FALSE;\n        Band_Rechts := FALSE;\n        Packet_Big := FALSE;\n        Packet_Small := FALSE;\n        Sortierbnad_Rechts := FALSE;\n        Sortierbnad_Links := FALSE;\n        Remover_left := FALSE;\n        Remover_rechts := FALSE;\n\t    newInfoSent := FALSE; \n\t    Publischer(\tMQTT_ADDR:= Global_DB.MQTT_IN_OUT,\n\t                topic:= 'amount',\n\t                payload:= Package,\n                    send:=newInfoSent\t\n);\n    END_IF;\n{endregion}\n\n{region 'Emitter'}\n    IF (Steps = 3) THEN\n        Emitter := TRUE;\n    END_IF;\n{endregion}\n\n{region 'Band-Einlauf'}\n    IF (Steps = 4 AND NOT M_Stop) THEN\n        Emitter := FALSE;\n        Band_Einlauf := TRUE;\n    ELSIF (Steps = 4 AND M_Stop) THEN\n        Band_Einlauf := FALSE;\n    END_IF;\n{endregion}\n\n{region 'Sortierband_Vor'}\n    IF (Steps = 5 AND NOT M_Stop) THEN\n        Sortierband_Vor := TRUE;\n        Band_Einlauf := TRUE;\n    ELSIF (Steps = 5 AND M_Stop) THEN\n        Band_Einlauf := FALSE;\n        Sortierband_Vor := FALSE;\n    END_IF;\n{endregion}\n\n{region 'Sortierband_Vor False'}\n    IF (Steps = 6) THEN\n        Band_Einlauf := FALSE;\n        Sortierband_Vor := FALSE;\n\t\tnewInfoSent := TRUE;\t  \n        Publischer(\tMQTT_ADDR:= Global_DB.MQTT_IN_OUT,\n\t                topic:= 'amount',\n\t                payload:= Package,\n                    send:=newInfoSent\t\n);\n    END_IF;\n{endregion}\n\n{region 'Sortierbnad_Links'}\n    IF (Steps = 7 AND NOT M_Stop) THEN\n        Sortierbnad_Links := TRUE;\n        Band_Links := TRUE;\n    ELSIF (Steps = 7 AND M_Stop) THEN\n        Sortierbnad_Links := FALSE;\n        Band_Links := FALSE;\n    END_IF;\n{endregion}\n\n{region 'Sortierbnad_Links_Ende'}\n    IF (Steps = 8 AND NOT M_Stop) THEN\n        Band_Links := TRUE;\n        Sortierbnad_Links := FALSE;\n    ELSIF (Steps = 8 AND M_Stop) THEN\n        Sortierbnad_Links := FALSE;\n        Band_Links := FALSE;\n    END_IF;\n{endregion}\n\n{region 'Links_Ende'}\n    IF (Steps = 9) THEN\n        Band_Links := FALSE;\n        Remover_left := TRUE;\n        Rundumleuchte := TRUE;\n    END_IF;\n{endregion}\n\n{region 'Sortierbnad_Rechts'}\n    IF (Steps = 10 AND NOT M_Stop) THEN\n        Sortierbnad_Rechts := TRUE;\n        Band_Rechts := TRUE;\n    ELSIF (Steps = 10 AND M_Stop) THEN\n        Sortierbnad_Rechts := FALSE;\n        Band_Rechts := FALSE;\n    END_IF;\n{endregion}\n\n{region 'Sortierbnad_Rechts_Ende'}\n    IF (Steps = 11 AND NOT M_Stop) THEN\n        Band_Rechts := TRUE;\n        Sortierbnad_Rechts := FALSE;\n    ELSIF (Steps = 11 AND M_Stop) THEN\n        Sortierbnad_Rechts := FALSE;\n        Band_Rechts := FALSE;\n    END_IF;\n{endregion}\n\n{region 'Rechts_Ende'}\n    IF (Steps = 12) THEN\n        Band_Rechts := FALSE;\n        Remover_rechts := TRUE;\n    END_IF;\n{endregion}\n\n{region 'Packet_Groß'}\n    IF (Sensor_Big AND Sensor_Small) THEN\n        Packet_Big := TRUE;\n    END_IF;\n    \n    IF (Sensor_Small AND NOT Sensor_Big ) THEN\n        Packet_Small := TRUE;\n    END_IF;\n{endregion}\n\n{region 'Licht'}\n    IF NOT NotAus THEN\n        Rundumleuchte := TRUE;\n    ELSIF Steps = 12 OR Steps = 9 THEN\n        Rundumleuchte := TRUE;\n    ELSE\n        Rundumleuchte := FALSE;\n    END_IF;\n    \n    Reset_licht := Reset;\n    Stop_licht := M_Stop;\n    Start_licht := M_Start;\n{endregion}\n\n{region 'STOP'} \n    IF NOT Stop_Button OR MQTT_Stop THEN\n        M_Stop := TRUE;\n    ELSIF Start_Button OR NOT NotAus OR MQTT_Start THEN\n        M_Stop := FALSE;\n    END_IF;\n{endregion}\n\n{region 'START'}  \n    IF Start_Button OR MQTT_Start THEN\n        M_Start := TRUE;\n    ELSIF NOT Stop_Button OR NOT NotAus OR MQTT_Stop THEN\n        M_Start := FALSE;\n    ELSIF NOT Auto_Betrieb AND Steps = 11 THEN\n        M_Start := FALSE;\n    ELSIF NOT Auto_Betrieb AND Steps = 9 THEN\n        M_Start := FALSE;\n    END_IF;\n{endregion}\n\n{region 'Zählen'}  \n    IEC_Counter_Packet_big(CU:=Sensor_Big,\n                           PV := 100,\n                           RESET := Reset,\n                           CV => Packet_Groz_Out\n     );\n    \n    IEC_Counter_Packet_klein(CU:=Sensor_Small AND NOT Sensor_Big,\n                              PV:=100,\n                              RESET:= Reset,\n                              CV=>Packet_Klein_Out);\n    \n    Packet_all_out := Packet_Groz_Out + Packet_Klein_Out;\n\t\t \n    Package.small := Packet_Klein_Out;\n    Package.big := Packet_Groz_Out;\n\tPackage.all := Packet_all_out;\n    \n{endregion}","LineInfoPersistence":"(string)72687196-6260-4c47-bdd5-6d81b1dd5edc_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)FUNCTION_BLOCK Logik\nVAR_INPUT\n\tSteps: INT;\n    Sensor_Big: BOOL;\n    Sensor_Small: BOOL;\n    NotAus: BOOL;\n    Reset: BOOL;\n    Stop_Button: BOOL;\n    Start_Button: BOOL;\n    Auto_Betrieb: BOOL;\n    Manual: BOOL;\n\tMQTT_Start: BOOL;\n\tMQTT_Stop: BOOL;\nEND_VAR\nVAR_OUTPUT\n\tEmitter: BOOL;\n    Band_Einlauf: BOOL;\n    Sortierband_Vor: BOOL;\n    Sortierbnad_Links: BOOL;\n    Band_Links:\tBOOL;\n    Sortierbnad_Rechts:\tBOOL;\n    Band_Rechts: BOOL;\n    Remover_left: BOOL;\n    Remover_rechts: BOOL;\n    Rundumleuchte: BOOL;\n    Packet_Groz_Out: WORD;\n    Packet_Klein_Out: WORD;\n\tPacket_all_out: WORD;\n    Reset_licht: BOOL;\n    Stop_licht: BOOL;\n    Start_licht: BOOL;\nEND_VAR\n\nVAR\n\tM_Stop : BOOL;\n\tIEC_Counter_Packet_big : CTU;\n\tIEC_Counter_Packet_klein : CTU;\n\tPublischer: Publischer;\n\tPackage: Package_Amount;\n\tnewInfoSent: BOOL;\nEND_VAR\n\nVAR_IN_OUT\n\tM_Start : BOOL;\n\tPacket_Big : BOOL;\n\tPacket_Small : BOOL;\nEND_VAR\n","LineInfoPersistence":"(string)72687196-6260-4c47-bdd5-6d81b1dd5edc_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)260","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}