{"payload":{"meta":{"Graph":{"@Type":"81297157","@Value":{"Guid":"(Guid)1fae8136-6984-4e59-b02b-5479ad1d8892","ParentGuid":"(Guid)542b4cb4-81da-47f9-8583-4e43e03c2aca","Name":"(string)Steps","Properties":{"@Type":"2c41fa04:IDictionary","@Value":{}},"TypeGuid":"(Guid)6f9dac99-8de1-4efc-8465-68ac443b7d08","EmbeddedTypeGuids":{"@Type":"[Guid]","@Value":["(Guid)a9ed5b7e-75c5-4651-af16-d2c27e98cb94","(Guid)3b83b776-fb25-43b8-99f2-3c507c9143fc"]}}},"TypeInfos":{"2c41fa04":"{2c41fa04-1834-41c1-816e-303c7aa2c05b}","81297157":"{81297157-7ec9-45ce-845e-84cab2b88ade}","Guid":"System.Guid","string":"System.String"}},"object":{"Graph":{"@Type":"6f9dac99","@Value":{"SpecialFunc":{"@Type":"0db3d7bb:Enum","@Value":"None"},"Implementation":{"@Type":"3b83b776","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string){region 'STEPS'}\n    CASE Steps OF\n        0:\n            Steps := 1;\n        1:\n            IF NOT Not_Aus OR Manual THEN\n                Steps := 2;\n            END_IF;\n        2:\n            IF (Start_Button AND NOT M_Start) OR Auto_Betrieb OR (MQTT_Start AND NOT M_Start) THEN\n                Steps := 3;\n            END_IF;\n        3:\n            IF NOT Lichttaster_Einlauf THEN\n                Steps := 4;\n            END_IF;\n        4:\n            IF R_TRIG_Instance.Q THEN\n                Steps := 5;\n            END_IF;\n        5:\n            IF Sortierband_Vor THEN\n                Steps := 6;\n            END_IF;\n        6:\n            IF Lichttaster_Links_Anfang AND Packet_Big THEN\n                Steps := 7;\n            END_IF;\n            \n            IF Lichttaster_Rechts_Anfang AND Packet_Small THEN\n                Steps := 10;\n            END_IF;\n        7:\n            IF R_TRIG_Instance_1.Q THEN\n                Steps := 8;\n            END_IF;\n        8:\n            IF R_TRIG_Instance_2.Q THEN\n                Steps := 9;\n            END_IF;\n        9:\n            IF IEC_Timer_TON_9.Q THEN\n                IF Auto_Betrieb THEN\n                    Steps := 3;\n                ELSE\n                    Steps := 0;\n                END_IF;\n            END_IF;\n        \n        10:\n            IF R_TRIG_Instance_3.Q THEN\n                Steps := 11;\n            END_IF;\n        11:    \n            IF R_TRIG_Instance_4.Q THEN\n                Steps := 12;\n            END_IF;\n        12:\n            IF IEC_Timer_TON_12.Q THEN\n                IF Auto_Betrieb THEN\n                    Steps := 3;\n                ELSE\n                    Steps := 0;\n                END_IF;\n            END_IF;\n            \n    END_CASE;\n    \n    {region 'Sensors'}\n        R_TRIG_Instance(CLK := Sensor_Palette);\n        R_TRIG_Instance_1(CLK := Lichttaster_Links_Anfang);\n        R_TRIG_Instance_2(CLK := Lichttaster_Links_Ende);\n        R_TRIG_Instance_3(CLK := Lichttaster_Rechts_Anfang);\n        R_TRIG_Instance_4(CLK := Lichttaster_Rechts_Ende);\n{endregion}\n    \n    {region 'Timers'}\n        IEC_Timer_TP_9(IN := Steps = 9,\n                        PT := T#3s);\n        IEC_Timer_TON_9(IN := IEC_Timer_TP_9.Q,\n                         PT := T#2s);\n        \n        IEC_Timer_TP_12(IN := Steps = 12,\n                         PT := T#3s);\n        IEC_Timer_TON_12(IN := IEC_Timer_TP_12.Q,\n                          PT := T#2s);\n{endregion}\n    \n    IF NOT Not_Aus THEN\n        Steps := 0;\n    END_IF;\n                \n{endregion}","LineInfoPersistence":"(string)1fae8136-6984-4e59-b02b-5479ad1d8892_Impl_LineIds"}}}},"Interface":{"@Type":"a9ed5b7e","@Value":{"TextDocument":{"@Type":"f3878285","@Value":{"TextBlobForSerialisation":"(string)FUNCTION_BLOCK Steps\n\nVAR_INPUT\n\tNot_Aus : BOOL;\n\tManual : BOOL;\n\tMQTT_Start: BOOL;\n\tStart_Button : BOOL;\n\tAuto_Betrieb: BOOL;\n\tLichttaster_Einlauf: BOOL;\n\tSensor_Palette: BOOL;\n\tSortierband_Vor: BOOL;\n\tLichttaster_Links_Anfang: BOOL;\n\tLichttaster_Rechts_Anfang: BOOL;\n\tLichttaster_Links_Ende: BOOL;\n\tLichttaster_Rechts_Ende: BOOL;\nEND_VAR\n\nVAR_OUTPUT\nEND_VAR\n\nVAR\n\t R_TRIG_Instance : R_TRIG;\n\t R_TRIG_Instance_1 : R_TRIG;\n\t R_TRIG_Instance_2 : R_TRIG;\n\t R_TRIG_Instance_3 : R_TRIG;\n\t R_TRIG_Instance_4 : R_TRIG;\n\t IEC_Timer_TP_9 : TP;\n\t IEC_Timer_TON_9: TON;\n\t IEC_Timer_TP_12 : TP;\n\t IEC_Timer_TON_12: TON;\nEND_VAR\n\t\nVAR_IN_OUT\n    Steps : INT;\n\tM_Start : BOOL;\n\tPacket_Big : BOOL;\n\tPacket_Small : BOOL;\nEND_VAR\n\n","LineInfoPersistence":"(string)1fae8136-6984-4e59-b02b-5479ad1d8892_Decl_LineIds"}}}},"UniqueIdGenerator":"(string)140","POULevel":{"@Type":"8e575c5b:Enum","@Value":"Standard"},"ChildObjectGuids":{"@Type":"ArrayList:IList","@Value":[]},"AddAttributeSubsequent":"(bool)False"}},"TypeInfos":{"0db3d7bb":"{0db3d7bb-cde0-4416-9a7b-ce49a0124323}","3b83b776":"{3b83b776-fb25-43b8-99f2-3c507c9143fc}","6f9dac99":"{6f9dac99-8de1-4efc-8465-68ac443b7d08}","8e575c5b":"{8e575c5b-1d37-49c6-941b-5c0ec7874787}","a9ed5b7e":"{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}","ArrayList":"System.Collections.ArrayList","bool":"System.Boolean","f3878285":"{f3878285-8e4f-490b-bb1b-9acbb7eb04db}","string":"System.String"}}},"FormatVersion":"1.0"}